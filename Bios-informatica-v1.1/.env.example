# Configure these values in Hostinger. Do not publish a real .env.
JWT_SECRET=
SITE_URL=https://biosinformatica.store
PORT=8000
NODE_ENV=production
COOKIE_SECURE=true
# Set only after verifying how many reverse proxies Hostinger uses:
# TRUST_PROXY_HOPS=1
# Absolute durable location, outside the public directory and deployment replacement:
# DB_PATH=/your/persistent/path/database.sqlite
# BACKUP_DIR=/your/persistent/path/backups
# First installation only; remove ADMIN_PASSWORD after successful creation:
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Supabase PostgreSQL: obtain from the Connect panel; never commit the real URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
# Optional PEM CA certificate from your provider (literal \n supported):
# DB_SSL_CA=
# DB_SSL=false is for a local test database only.
